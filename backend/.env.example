PROJECT_NAME="Civic Copilot API"
PROJECT_VERSION="0.1.0"
API_V1_PREFIX="/api/v1"

POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="civic_copilot"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"

# Optional override:
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/civic_copilot"

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
UPLOAD_DIR="uploads"

NLP_SERVICE_URL="http://localhost:9001/analyze"
NLP_SERVICE_TIMEOUT_SECONDS=10

CV_SERVICE_URL="http://localhost:9002/detect"
CV_SERVICE_TIMEOUT_SECONDS=20

INTEGRATION_RETRY_ATTEMPTS=3
INTEGRATION_RETRY_BACKOFF_SECONDS=0.5
